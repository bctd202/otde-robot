MARKET_DATA_PROVIDER=mock
SYMBOLS=SPY,QQQ,IWM
DATABASE_URL=sqlite:///./liquidity_hunter.db
MOCK_SCENARIO=active
# Synthetic option rows are disabled unless this explicit, non-actionable demo mode is enabled.
ENABLE_DEMO_OPTION_CONTRACTS=false
PAPER_ONLY=true
EVENT_TRADING_ENABLED=false
CLOSE_TO_CLOSE_SQUEEZE_ENABLED=false
# Set MARKET_DATA_PROVIDER=tradier only when a read-only market-data token is present.
TRADIER_API_TOKEN=
TRADIER_BASE_URL=https://api.tradier.com/v1
TRADIER_DATA_MODE=unknown
PARLAY_SYMBOLS=SPY,QQQ,IWM,TSLA,NVDA,AAPL,AMZN,META,MSFT,GOOGL,AVGO,IBIT
