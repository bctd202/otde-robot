MARKET_DATA_PROVIDER=mock
SYMBOLS=SPY,QQQ,IWM
DATABASE_URL=sqlite:///./liquidity_hunter.db
MOCK_SCENARIO=active
# Synthetic option rows are disabled unless this explicit, non-actionable demo mode is enabled.
ENABLE_DEMO_OPTION_CONTRACTS=false
PAPER_ONLY=true
EVENT_TRADING_ENABLED=false
CLOSE_TO_CLOSE_SQUEEZE_ENABLED=false
# Set MARKET_DATA_PROVIDER=tradier only when a read-only market-data token is present.
TRADIER_API_TOKEN=
TRADIER_BASE_URL=https://api.tradier.com/v1
# Required for Tradier: set explicitly to live only for verified real-time entitlement,
# otherwise set delayed. Unknown remains research-only and non-actionable.
TRADIER_DATA_MODE=unknown
# Hard local guard below Tradier's documented 120 market-data requests/minute.
TRADIER_REQUEST_BUDGET_PER_MINUTE=100
MARKET_QUOTE_CACHE_SECONDS=10
MARKET_CANDLE_CACHE_SECONDS=45
MARKET_CHAIN_CACHE_SECONDS=20
PARLAY_SYMBOLS=SPY,QQQ,IWM,TSLA,NVDA,AAPL,AMZN,META,MSFT,GOOGL,AVGO,IBIT,GLD,SLV,TLT,USO,UNG,AMD,COIN,PLTR
PARLAY_SYMBOL_LIMIT=20
PARLAY_FLEX_LIMIT=2
PARLAY_BACKGROUND_SCANNER_ENABLED=true
# Evaluate the newly completed one-minute candle at second 5 of each minute.
PARLAY_SCAN_SECOND=5
PARLAY_SCAN_MISFIRE_GRACE_SECONDS=30
